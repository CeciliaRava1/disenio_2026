@startuml usecaseDiagram
left to right direction
skinparam style strictuml

actor "Encargado de Personal" as EP
actor "Usuario" as US
actor "Secretaria" as SE
actor "Servidor de correo" as SC


usecase "6. Registrar un profesional" as U6
usecase "7. Dar de baja un profesional" as U7
usecase "8. Modificar profesional" as U8
usecase "9. Consultar profesional" as U9
usecase "4. Generar agenda de profesional" as U4
usecase "2. Solicitud de turno" as U2
usecase "26. Generar informe de turnos asistidos por profesional" as U26
usecase "28. Generar estadística de turnos por estado" as U28
usecase "16. Iniciar sesion" as U16
usecase "3. Registrar aceptación de solicitud de ausencia de profesional." as U3

EP --> U6
EP --> U7
EP --> U8
EP --> U9
EP --> U4
EP --> U26
EP --> U28

EP--> US
US --> U16
SE --|> US
SC --> U3

SC --> U2
@enduml