@startuml DiagramaClases
skinparam style strictuml
skinparam linetype ortho

class GestorRegistrarPagoCuota {
    + montoBase: float
    + prestamoSel: Prestamo
    + montoAAbonar: float

    + calcularMontoAAbonar(montoBase: float, prestamo: Prestamo): float
    + crearEstrategia()
    + retornarMontoAAbonar(): float
}

class IEstrategiaCalculoMora {
    + calcularMontoAAbonar(montoBase: float, prestamo: Prestamo): float

}

class EstrategiaCalculoPorcentual {
    + new()
    + calcularMontoAAbonar(montoBase: float, prestamo: Prestamo): float
    + getFechaActual(): Date

}

class EstrategiaCalculoFijo {
    + new()
    + calcularMontoAAbonar(montoBase: float, prestamo: Prestamo): float

}

class Prestamo {
    + obtenerParametrosMora(): String[]
    
}

class TipoPrestamo {
    + nombre: String
    
}

class DefinicionMora {
    + porcentajeRecargo: float
}

GestorRegistrarPagoCuota .> IEstrategiaCalculoMora
GestorRegistrarPagoCuota .> DefinicionMora
GestorRegistrarPagoCuota .> Prestamo
Prestamo -> TipoPrestamo
TipoPrestamo -> DefinicionMora
EstrategiaCalculoPorcentual .|> IEstrategiaCalculoMora
EstrategiaCalculoFijo .|> IEstrategiaCalculoMora
EstrategiaCalculoPorcentual -> DefinicionMora
@enduml