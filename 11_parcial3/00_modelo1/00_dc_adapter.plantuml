@startuml DiagramaClases
skinparam style strictuml
skinparam linetype ortho


class GestorRegistrarPagoCuota {
    + dni: Int
    + fecha: DateTime
    + prestamoSeleccionado: Prestamo
}

class IAdaptadorCentralDeudores {
    + obtenerCodigoPago(dni: String, fecha: DateTime): Int
}

class AdaptadorSENASA {
    + codigoPago: int
    + fecha: DateTime

    + new()
    + obtenerCodigoPago(dni: String, fecha: DateTime): Int
    + getFechaActual(): DateTime
    + adaptarCodigoPago()
}

class AdaptadorAGIP {
    + new()
    + obtenerCodigoPago(dni: String, fecha: DateTime): Int
}

class ServicioSENASA {
    + consultarDeuda(dni: String, fecha: DateTime): String
    
}

class ServicioAGIP {
    
}

class Prestamo {
    + nro: Int
}

class Cliente {
    + dni: Int
}

GestorRegistrarPagoCuota -> IAdaptadorCentralDeudores
AdaptadorSENASA -|> IAdaptadorCentralDeudores
AdaptadorAGIP -|> IAdaptadorCentralDeudores
ServicioSENASA o-> AdaptadorSENASA
ServicioAGIP o-> AdaptadorAGIP
GestorRegistrarPagoCuota -> Cliente
GestorRegistrarPagoCuota -> Prestamo



@enduml