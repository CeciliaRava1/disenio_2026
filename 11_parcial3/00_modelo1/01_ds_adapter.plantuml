@startuml diagramaSecuencia

autonumber
skinparam style strictuml
skinparam sequenceMessageAlign center
skinparam maxMessageSize 150

control GestorRegistrarPagoCuota as ":GestorRegistrarPagoCuota"
entity InterfazConsultaDeudores as ":InterfazConsultaDeudores"
participant AdaptadorSENASA as ":AdaptadorSENASA"
participant ServicioSENASA as ":ServicioSENASA"

'8. Sistema: Obtiene del servicio SENASA el codigo de pago correspondiente al prestamo seleccionado
GestorRegistrarPagoCuota -> InterfazConsultaDeudores : obtenerCodigoPago(dni: String, fecha: DateTime): Int
InterfazConsultaDeudores --> AdaptadorSENASA : new(): AdaptadorSENASA
InterfazConsultaDeudores -> AdaptadorSENASA : obtenerCodigoPago(dni: String, fecha: DateTime): String[][]
AdaptadorSENASA -> AdaptadorSENASA : getFechaActual(): DateTime
AdaptadorSENASA -> ServicioSENASA : consultarDeuda(dni: String, fecha: DateTime): String
AdaptadorSENASA -> AdaptadorSENASA : adaptarCodigoPago()
AdaptadorSENASA --> InterfazConsultaDeudores : retornarCodigoPago(): Int
@enduml