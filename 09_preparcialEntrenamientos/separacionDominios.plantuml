@startuml separacionDominios
skinparam shadowing false

' Configuración de los contenedores
skinparam rectangle {
    BackgroundColor White
    BorderColor Black
    fontColor Black
}

' Configuración de los óvalos (casos de uso) y sus colores por estereotipo
skinparam usecase {
    BackgroundColor<<Soporte>> #F8A145
    BackgroundColor<<Generico>> #B09EE6
    BackgroundColor<<Core>> #FFB6C1
    BorderColor Black
    FontColor Black
}

' ==========================================
' Service Containment Space: Dominios de Soporte
' ==========================================
rectangle "Service Containment Space\nDominios de Soporte" as ContenedorSoporte {
    usecase "Deportista" as Deportista <<Soporte>>
    usecase "Alimentacion" as Alimentacion <<Soporte>>
}

' ==========================================
' Service Containment Space: Dominios Genéricos
' ==========================================
rectangle "Service Containment Space\nDominios Genéricos" as ContenedorGenericos {
    usecase "Usuarios" as usuarios <<Generico>>
    usecase "notificacionPush" as NotificacionPush <<Generico>>
    usecase "IntegracionInstagram" as IntegracionInstagram <<Generico>>
    usecase "VisualizacionMapas" as VisualizacionMapas <<Generico>>
    usecase "IntegracionGPS" as IntegracionGPS <<Generico>>
}

' ==========================================
' Service Containment Space: Dominios Core
' ==========================================
rectangle "Service Containment Space\nDominios Core" as ContenedorCore {
    usecase "MetaEntrenamiento" as MetaEntrenamiento <<Core>>
    usecase "Entrenamiento" as Entrenamiento <<Core>>
    usecase "SeguimientoNutricional" as SeguimientoNutricional <<Core>>
}

' Enlaces ocultos para forzar la alineación horizontal de izquierda a derecha
ContenedorSoporte -[hidden]right-> ContenedorGenericos
ContenedorGenericos -[hidden]right-> ContenedorCore

@enduml